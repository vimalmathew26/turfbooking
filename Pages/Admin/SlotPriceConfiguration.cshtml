@page
@model turfbooking.Pages.Admin.SlotPriceConfigurationModel
@{
    ViewData["Title"] = "Slot Price Configuration";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class=" alert alert-danger">@TempData["ErrorMessage"]</div>
}
<form method="post" asp-page-handler="Save" class="p-4 shadow-sm border rounded bg-light" style="max-width: 600px; margin: auto;">
    <h4 class="mb-4 text-primary fw-bold">Slot Price Configuration</h4>

    <input asp-for="GroundId" value="@Model.GroundId" type="hidden">
    <input asp-for="CourtId" value="@Model.CourtId" type="hidden"/>

    <div asp-validation-summary="All"></div>
   
    <!-- Apply to All Dates Toggle -->
    <div class="mb-3">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="toggleDate" onchange="toggleDateInput()" />
            <label class="form-check-label fw-semibold" for="toggleDate">Apply to all dates</label>
        </div>
    </div>

    <!-- Date Input Field -->
    <div class="mb-3" id="dateFieldGroup">
        <label class="form-label fw-semibold">Select Date</label>
        <input asp-for="SlotPrice.Date" type="date" class="form-control" id="dateInput" />
        <span asp-validation-for="SlotPrice.Date" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">From Time</label>
        <input asp-for="SlotPrice.StartTime" type="time" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">To Time</label>
        <input asp-for="SlotPrice.EndTime" type="time" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Price (₹)</label>
        <input asp-for="SlotPrice.Price" type="number" class="form-control" placeholder="e.g. 500" required />
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-save me-1"></i> Save
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleDateInput() {
            const checkbox = document.getElementById("toggleDate");
            const dateGroup = document.getElementById("dateFieldGroup");
            const dateInput = document.getElementById("dateInput");

            if (checkbox.checked) {
                dateGroup.style.display = "none";
                dateInput.value = "";
            } else {
                dateGroup.style.display = "block";
            }
        }       
        document.addEventListener("DOMContentLoaded", function () {
            toggleDateInput();
        });
    </script>
}
